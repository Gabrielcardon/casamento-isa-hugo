diff --git a/src/components/Venue.tsx b/src/components/Venue.tsx
new file mode 100644
index 0000000..4aaf856
--- /dev/null
+++ b/src/components/Venue.tsx
@@ -0,0 +1,95 @@
+import { coupleDisplayName, wedding } from '../config/wedding'
+
+/** Um raminho floral simples, no espírito da identidade visual (traço leve, tons coral/oliva). */
+function FloralAccent({ className = '' }: { className?: string }) {
+  return (
+    <svg
+      viewBox="0 0 120 320"
+      fill="none"
+      className={className}
+      aria-hidden
+    >
+      <path
+        d="M60 20 C 58 90, 62 180, 58 300"
+        stroke="var(--color-olive)"
+        strokeWidth="2"
+        strokeLinecap="round"
+      />
+      {[
+        { cy: 55, r: 14, dx: -22, color: 'var(--color-coral)' },
+        { cy: 95, r: 11, dx: 20, color: 'var(--color-peach)' },
+        { cy: 140, r: 13, dx: -20, color: 'var(--color-coral)' },
+        { cy: 190, r: 10, dx: 18, color: 'var(--color-lavender)' },
+        { cy: 235, r: 12, dx: -18, color: 'var(--color-peach)' },
+        { cy: 275, r: 9, dx: 16, color: 'var(--color-sky)' },
+      ].map((b, i) => (
+        <g key={i} transform={`translate(${60 + b.dx} ${b.cy})`}>
+          <path
+            d={`M0 0 L${-b.dx / 3} ${-14}`}
+            stroke="var(--color-olive)"
+            strokeWidth="1.5"
+            strokeLinecap="round"
+          />
+          <circle r={b.r} fill={b.color} opacity="0.85" />
+        </g>
+      ))}
+    </svg>
+  )
+}
+
+export function Venue() {
+  const mapQuery = encodeURIComponent(wedding.venueAddress)
+
+  return (
+    <section id="local" className="relative overflow-hidden bg-cream px-6 py-24 md:px-10 md:py-32">
+      <FloralAccent className="pointer-events-none absolute -left-6 top-10 hidden h-72 w-28 opacity-70 md:block" />
+      <FloralAccent className="pointer-events-none absolute -right-6 bottom-10 hidden h-72 w-28 rotate-180 opacity-50 lg:block" />
+
+      <div className="relative mx-auto max-w-3xl text-center">
+        <h2 className="font-display text-4xl font-medium tracking-tight text-olive-deep md:text-5xl">
+          Informações
+        </h2>
+        <p className="mt-3 font-script text-3xl text-olive md:text-4xl">{coupleDisplayName}</p>
+
+        <div className="mx-auto mt-12 grid gap-4 text-left">
+          <div className="border border-olive/30 bg-olive px-6 py-5 md:px-8 md:py-6">
+            <p className="font-display text-xl font-semibold text-cream md:text-2xl">
+              {wedding.dateLabel}
+            </p>
+            <p className="mt-1 font-sans text-sm text-cream/85">das {wedding.timeLabel}</p>
+          </div>
+
+          <div className="bg-sage px-6 py-5 md:px-8 md:py-6">
+            <p className="font-display text-xl font-semibold text-olive-deep md:text-2xl">
+              {wedding.venue}
+            </p>
+            <p className="mt-1 font-sans text-sm text-olive-deep/80">{wedding.venueAddress}</p>
+          </div>
+
+          <div className="bg-sage-soft px-6 py-5 font-sans text-sm leading-relaxed text-olive-deep/90 md:px-8 md:py-6 md:text-base">
+            {wedding.venueAtmosphere}
+          </div>
+        </div>
+
+        <div className="mt-10 overflow-hidden border border-olive/20 shadow-sm">
+          <iframe
+            title={`Mapa — ${wedding.venue}`}
+            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
+            className="h-72 w-full grayscale-[15%] md:h-96"
+            loading="lazy"
+            referrerPolicy="no-referrer-when-downgrade"
+          />
+        </div>
+
+        <a
+          href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
+          target="_blank"
+          rel="noreferrer"
+          className="mt-5 inline-flex items-center gap-2 font-sans text-sm font-medium tracking-wide text-olive underline decoration-coral/60 decoration-2 underline-offset-4 transition-colors hover:text-coral"
+        >
+          Ver rota até o local ↗
+        </a>
+      </div>
+    </section>
+  )
+}
